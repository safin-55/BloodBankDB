@model BloodBankApp.Models.Donor

<h2>Delete Donor</h2>

<p>Are you sure you want to delete this donor?</p>

<p>Name: @Model.FullName</p>
<p>Blood Group: @Model.BloodGroup</p>
<p>Contact: @Model.ContactNo</p>

<form action="/Donors/DeleteConfirmed/@Model.DonorId" method="post">
    <input type="hidden" name="id" value="@Model.DonorId" />
    <button type="submit">Yes, Delete</button>
</form>
<a href="/Donors/Index">Cancel</a>